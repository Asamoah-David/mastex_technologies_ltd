# ───────────────────────────────────────────────────────────────
# Mastex Technologies Ltd — Environment Variables
# Copy to `.env` and fill in. Never commit `.env`.
# ───────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Prisma) — Supabase Postgres connection string
# Use the "Connection pooling" (PgBouncer, port 6543) URL for the app,
# and the direct URL (port 5432) for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mastex?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mastex?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Storage bucket for the media library
SUPABASE_STORAGE_BUCKET="media"

# Auth / sessions
AUTH_SECRET="generate-a-long-random-string"

# Optional: seed a super admin (used by prisma/seed.ts)
SEED_SUPERADMIN_EMAIL="admin@mastex.tech"
SEED_SUPERADMIN_PASSWORD="ChangeMe!2026"

# Rate limiting (optional Upstash Redis — falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (optional). Point at a Slack/Discord webhook or your own
# collector; leave empty to log to the server console only. Sentry-ready —
# swap src/lib/observability.ts for the Sentry SDK without touching callers.
ERROR_WEBHOOK_URL=""
