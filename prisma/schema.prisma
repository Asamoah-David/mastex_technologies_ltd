// ─────────────────────────────────────────────────────────────────────────────
// Mastex Technologies Ltd — Prisma schema
// Datasource: Supabase PostgreSQL. Use DATABASE_URL (pooled) for the app and
// DIRECT_URL (direct 5432) for migrations.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ─────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT
  VIEWER
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  CONCEPT
  IN_DEVELOPMENT
  BETA
  LIVE
  DEPRECATED
}

enum LeadType {
  CONTACT
  SALES
  PARTNERSHIP
  JOB_APPLICATION
  DEMO_REQUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  WON
  LOST
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
  OTHER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

// ─────────────────────────── Identity & Access ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  // Mirrors the Supabase Auth user id (auth.users.id) when wired up.
  supabaseId    String?   @unique
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          Role      @default(VIEWER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  mfaEnabled    Boolean   @default(false)

  // Authored content
  blogPosts     BlogPost[]
  docArticles   DocArticle[]
  auditLogs     AuditLog[]
  assignedLeads Lead[]     @relation("LeadOwner")
  mediaUploads  Media[]

  permissions   PermissionOnUser[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
  @@index([email])
}

model Permission {
  id          String             @id @default(cuid())
  key         String             @unique // e.g. "products:write"
  description String?
  users       PermissionOnUser[]
  createdAt   DateTime           @default(now())
}

// Explicit per-user permission grants layered on top of the role defaults.
model PermissionOnUser {
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  grantedAt    DateTime   @default(now())

  @@id([userId, permissionId])
}

// ───────────────────────────── Taxonomy ────────────────────────────────────

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Industry {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  products    Product[]  @relation("ProductIndustries")
  solutions   Solution[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  posts     TagsOnPosts[]
  createdAt DateTime       @default(now())
}

// ───────────────────────────── Products ────────────────────────────────────

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  tagline         String?
  description     String           // short
  longDescription String?          @db.Text
  status          ProductStatus    @default(IN_DEVELOPMENT)
  featured        Boolean          @default(false)
  order           Int              @default(0)

  logoUrl         String?
  coverUrl        String?
  demoUrl         String?
  repoUrl         String?
  docsUrl         String?

  pricing         Json?            // [{ tier, price, period, features[] }]

  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?
  industries      Industry[]       @relation("ProductIndustries")

  features        ProductFeature[]
  media           ProductMedia[]
  changelog       ChangelogEntry[]

  // SEO
  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([featured])
  @@index([categoryId])
}

model ProductFeature {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  title       String
  description String?
  icon        String?
  isBenefit   Boolean  @default(false) // false = feature, true = benefit
  order       Int      @default(0)

  @@index([productId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      MediaType @default(IMAGE)
  url       String
  caption   String?
  order     Int       @default(0)

  @@index([productId])
}

model ChangelogEntry {
  id          String        @id @default(cuid())
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  version     String
  title       String
  body        String        @db.Text
  status      ContentStatus @default(PUBLISHED)
  releasedAt  DateTime      @default(now())

  @@index([productId])
}

// ───────────────────────────── Solutions ───────────────────────────────────

model Solution {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String
  body        String?       @db.Text
  icon        String?
  coverUrl    String?
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)

  industry    Industry?     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  industryId  String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([industryId])
}

// ─────────────────────────────── Blog ──────────────────────────────────────

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  excerpt         String?
  content         String         @db.Text
  coverUrl        String?
  status          ContentStatus  @default(DRAFT)
  publishedAt     DateTime?
  readingMinutes  Int            @default(3)
  views           Int            @default(0)

  author          User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId        String?
  category        BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?
  tags            TagsOnPosts[]

  // SEO
  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model TagsOnPosts {
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([postId, tagId])
}

// ────────────────────────── Documentation ──────────────────────────────────

model DocCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  icon        String?
  order       Int           @default(0)
  articles    DocArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DocArticle {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  content     String        @db.Text // markdown
  status      ContentStatus @default(PUBLISHED)
  version     String        @default("1.0")
  order       Int           @default(0)

  category    DocCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?

  // self-relation for nested articles
  parent      DocArticle?   @relation("DocTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId    String?
  children    DocArticle[]  @relation("DocTree")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([parentId])
}

// ─────────────────────────── Media Library ─────────────────────────────────

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  MediaFolder[] @relation("FolderTree")
  media     Media[]
  createdAt DateTime      @default(now())

  @@index([parentId])
}

model Media {
  id         String       @id @default(cuid())
  name       String
  type       MediaType    @default(IMAGE)
  url        String
  storageKey String?      // path within the Supabase storage bucket
  mimeType   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  alt        String?
  tags       String[]     @default([])

  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId   String?
  uploadedBy User?        @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderId String?

  createdAt  DateTime     @default(now())

  @@index([type])
  @@index([folderId])
}

// ─────────────────────── Leads & Communications ────────────────────────────

model Lead {
  id        String      @id @default(cuid())
  type      LeadType    @default(CONTACT)
  status    LeadStatus  @default(NEW)
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String      @db.Text
  metadata  Json?       // form-specific extra fields
  source    String?     // page / campaign
  notes     String?     @db.Text

  owner     User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId   String?

  // job applications reference a posting
  job       JobPosting? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId     String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([email])
}

// ───────────────────────────── Careers ─────────────────────────────────────

model JobPosting {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  department  String
  location    String
  type        JobType       @default(FULL_TIME)
  description String        @db.Text
  requirements String?      @db.Text
  status      ContentStatus @default(PUBLISHED)
  applications Lead[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

// ──────────────────────── Site Settings & CMS ──────────────────────────────

// Key/value store for editable site content blocks (homepage, footer, etc.).
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "home.hero", "company.details", "footer"
  group     String   @default("general")
  value     Json
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id        String           @id @default(cuid())
  label     String
  href      String
  location  String           @default("header") // header | footer
  order     Int              @default(0)
  isExternal Boolean         @default(false)
  parent    NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  NavigationItem[] @relation("NavTree")

  @@index([location])
}

// ─────────────────────── Audit & Analytics ─────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String   // e.g. "product.update"
  entity    String?  // e.g. "Product"
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity])
  @@index([createdAt])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  visitors    Int      @default(0)
  pageViews   Int      @default(0)
  leads       Int      @default(0)
  signups     Int      @default(0)
  topPages    Json?    // [{ path, views }]
  createdAt   DateTime @default(now())

  @@index([date])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  device    String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}
